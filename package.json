{
  "name": "ocp-catalog",
  "version": "0.2.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.3.13",
  "workspaces": [
    "packages/*",
    "examples/typescript",
    "apps/ocp-site-web",
    "apps/shopping-agent-api",
    "apps/shopping-agent-web",
    "apps/coffee-merchant-api"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "lint": "turbo lint",
    "site:check": "bun scripts/check-docs-integrity.ts",
    "site:dev": "bun run --cwd apps/ocp-site-web dev",
    "site:start": "bun run --cwd apps/ocp-site-web start",
    "site:build": "bun run --cwd apps/ocp-site-web build",
    "skill:sync": "bun scripts/sync-skill-copies.ts",
    "skill:check": "bun scripts/sync-skill-copies.ts --check",
    "skill:ocp:export": "bun scripts/export-ocp-skill.ts",
    "shopping:start": "bun run --cwd apps/shopping-agent-api start",
    "shopping:check": "bun run --cwd packages/agent-runtime typecheck && bun run --cwd apps/shopping-agent-api typecheck && bun run --cwd apps/shopping-agent-web typecheck && tsc -p tests/shopping-e2e/tsconfig.json --noEmit",
    "shopping:test": "bun test packages/agent-runtime apps/shopping-agent-api tests/shopping-e2e",
    "coffee:check": "bun run --cwd apps/coffee-merchant-api check && bun run --cwd apps/coffee-merchant-api typecheck",
    "shopping:integration": "bun test tests/shopping-e2e/http-flow.test.ts",
    "shopping:build": "bun run --cwd packages/agent-runtime build && bun run --cwd apps/shopping-agent-api build && bun run --cwd apps/shopping-agent-web build"
  },
  "devDependencies": {
    "@types/bun": "^1.3.1",
    "turbo": "^2.5.8",
    "typescript": "^5.9.3"
  }
}
