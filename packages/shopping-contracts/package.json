{
  "name": "@ocp-catalog/shopping-contracts",
  "version": "0.2.0",
  "description": "Demo shopping/checkout contracts shared by the shopping agent (A) and the coffee merchant (B). NOT part of the OCP Catalog standard.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Open-Commerce-Protocol/OCP-Catalog.git",
    "directory": "packages/shopping-contracts"
  },
  "type": "module",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./browser": {
      "bun": "./src/browser.ts",
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "default": "./dist/browser.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "bun ../../scripts/build-protocol-package.ts",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "bun test --pass-with-no-tests"
  },
  "dependencies": {
    "@ocp-catalog/ocp-schema": "workspace:*",
    "zod": "^4.1.12"
  }
}
