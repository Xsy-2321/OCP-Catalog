# OCP Catalog — protocol repo environment
#
# Copy this file to .env for local development. Keep real secrets out of
# committed files. The production applications (and their much larger env
# surface) live in the separate ocp-catalog-instances repo.

# ocp-site-web (the protocol docs/marketing site)
OCP_SITE_PORT=5173

# Minimal example catalog nodes (examples/typescript, examples/python, examples/go).
# All optional; each example has sensible defaults.
CATALOG_ID=cat_example
CATALOG_NAME=Example Catalog
PORT=4400
PUBLIC_BASE_URL=http://localhost:4400

# Shopping application: `bun run shopping:demo` starts A + B on loopback.
# Copy this file to .env and fill this one backend-only key for Agent mode.
# Leave empty to use manual search; no model API call is made without a key.
DEEPSEEK_API_KEY=
SHOPPING_LLM_BASE_URL=https://api.deepseek.com
# Official API name for DeepSeek V4.1 Flash (not "ds4.1flash").
SHOPPING_LLM_MODEL=deepseek-flash
SHOPPING_LLM_TIMEOUT_MS=30000
SHOPPING_PORT=4310
MERCHANT_PORT=8787
SHOPPING_DEMO_DATA_DIR=.codex-tmp/shopping-demo
