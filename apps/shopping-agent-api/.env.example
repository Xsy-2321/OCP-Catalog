# Local HTTP shopping only; payment remains simulated. Bun 1.3.13.
SHOPPING_MODE=http
SHOPPING_PORT=4310
# Relative paths below assume `bun run shopping:start` (working directory is this app).
# Prefer absolute paths when exporting variables from a different directory.
SHOPPING_DATA_DIR=../../.codex-tmp/shopping-http/agent
SHOPPING_MERCHANT_ORIGIN=http://127.0.0.1:8787
SHOPPING_MERCHANT_ID=merchant_coffee_demo
SHOPPING_CATALOG_ID=catalog_coffee_demo
SHOPPING_AUTH_ISSUER=agent_a_demo
SHOPPING_AUTH_KEY_ID=agent_a_test
# Backend-only Ed25519 private key, outside tracked files. Never log its contents.
SHOPPING_AUTH_PRIVATE_KEY_PATH=../../.codex-tmp/shopping-http/agent-private.pem
# Explicit A-only testing alternative: SHOPPING_MODE=mock
