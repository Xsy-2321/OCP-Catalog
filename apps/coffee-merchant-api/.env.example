# coffee-merchant-api — local demo configuration
#
# Copy to `.env` in this directory. Bun loads `.env` from the working directory,
# so it is read when the server is started through this package's `start` script
# (or after `cd apps/coffee-merchant-api`).
#
# These variables belong to the demo merchant only. Nothing here reads another
# service's configuration, and nothing has a default that would quietly point at
# real data.

# Where the socket is opened. Loopback by default, on purpose: caller identity is
# the `x-dev-caller-id` header, which the caller writes itself, so binding to
# 0.0.0.0 lets anything that can reach the port act as any caller. Set this only
# if you mean it — the server prints a warning when you do.
MERCHANT_HOST=127.0.0.1
MERCHANT_PORT=8787

# Required. There is deliberately no default: an in-memory database would accept
# orders and lose them on restart, which is the exact failure the idempotency
# requirement exists to prevent.
MERCHANT_DB_PATH=./merchant.db

# The URL this merchant advertises in discovery and manifest. Defaults to
# http://127.0.0.1:<port>. It does not have to match the bound address, but it
# must be an address the caller can actually reach, because A takes the checkout
# URL from these responses rather than constructing one.
# MERCHANT_PUBLIC_BASE_URL=http://127.0.0.1:8787

# Browser origins allowed by CORS, comma separated. Empty means no browser page
# served from another origin can call this merchant.
MERCHANT_ALLOWED_ORIGINS=http://localhost:5173

# Trusted authorization public keys: a JSON object mapping `key_id` to
# {"public_key_pem":"<PEM public key>","issuer":"agent_a_demo"}.
# Public halves only. The signed issuer must equal this configured issuer.
# A key that arrives inside a request is never
# trusted, so if this is unset the merchant still starts and rejects every
# checkout — fail-closed.
#
# Build one from the committed test key (run from the repository root):
#   bun -e 'const p="fixtures/shopping/keys/agent_a_test.public.pem";await Bun.write("apps/coffee-merchant-api/trusted-keys.json",JSON.stringify({agent_a_test:{public_key_pem:await Bun.file(p).text(),issuer:"agent_a_demo"}},null,2))'
MERCHANT_TRUSTED_KEYS_PATH=./trusted-keys.json

# Quote lifetime in seconds. 900 matches the fixture window (10:00 -> 10:15).
MERCHANT_QUOTE_TTL_SECONDS=900

# How long a checkout may spend settling before it answers "unknown" (202).
# Maximum 225000. The socket has to stay open past the deadline to deliver that
# 202, and Bun caps a socket's idle timeout at 255s, so a longer settlement could
# not be served: a larger value is a startup error rather than a silent clamp.
MERCHANT_CHECKOUT_DEADLINE_MS=5000

# Fault injection is only reachable when this is 1. Setting MERCHANT_FAULTS
# without it is a startup error rather than a silent no-op, because a run that
# dropped the requested faults would be reported as "the fault was exercised"
# while the honest path never ran.
MERCHANT_TEST_MODE=0
# Known faults: payment_timeout_then_succeed, payment_declined,
# price_raised_after_quote, stock_exhausted_after_quote,
# response_dropped_after_settlement
# MERCHANT_FAULTS=payment_declined,price_raised_after_quote
